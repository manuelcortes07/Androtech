# Variables de entorno para AndroTech
# Copiar este archivo a .env y rellenar con valores reales

# ==========================================
# STRIPE CONFIGURATION (Test Mode)
# ==========================================
# Obtén estas claves desde: https://dashboard.stripe.com/test/apikeys

# Clave secreta de Stripe (comienza con sk_test_)
# NUNCA compartir esta clave en público o git
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clave pública de Stripe (comienza con pk_test_)
# Esta clave es segura para usar en frontend
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secret para validar webhooks de Stripe (comienza con whsec_)
# Se obtiene al ejecutar: stripe listen --forward-to localhost:5000/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ==========================================
# STRIPE — SUSCRIPCIÓN DEL SaaS (Fase 3b) — FLUJO SEPARADO
# ==========================================
# Claves PROPIAS de la suscripción del SaaS (yo cobrando a los talleres).
# NO mezclar con las de arriba (que son para que un taller cobre a SUS clientes).
# Pueden ser de la MISMA cuenta Stripe (en modo test) pero el webhook y el price
# son distintos.
#
# Clave secreta (sk_test_...). Misma cuenta vale; el código usa un StripeClient
# dedicado para no tocar la clave del flujo de reparaciones.
STRIPE_SAAS_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Price recurrente de 24,99 €/mes (Productos → tu producto → API ID del precio).
STRIPE_SAAS_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXXXXXX

# Secret del webhook de SUSCRIPCIÓN (endpoint /saas/webhook). DISTINTO del de
# reparaciones. Se obtiene con: stripe listen --forward-to localhost:5000/saas/webhook
STRIPE_SAAS_WEBHOOK_SECRET=whsec_YOUR_SAAS_WEBHOOK_SECRET_HERE

# ==========================================
# FLASK CONFIGURATION
# ==========================================
# Entorno: 'development' (local) o 'production' (Render/Railway).
# En production, SECRET_KEY es OBLIGATORIA (la app falla si falta) y las cookies
# de sesión se marcan Secure (solo HTTPS).
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=True
# Clave de sesión/CSRF. En producción, aleatoria y fuerte (en Render la genera
# el Blueprint). Generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=tu_clave_secreta_muy_segura_aqui_CAMBIAR_EN_PRODUCCION

# Clave del endpoint /admin/seed-demo (siembra datos demo; sólo admin). Opcional.
# SEED_KEY=demo2026

# ==========================================
# DATABASE
# ==========================================
# LOCAL (SQLite): ruta del fichero.
DATABASE_PATH=database/andro_tech.db
# PRODUCCIÓN (PostgreSQL): si DATABASE_URL está definida, se usa Postgres en vez
# de SQLite. Render/Railway la inyectan solas. Se acepta postgres:// y
# postgresql:// (database.py las normaliza a postgresql+psycopg://).
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Carpeta de subidas (fotos/firmas). Debe quedar bajo static/. En un host con
# disco persistente, móntalo aquí. Por defecto static/uploads.
# UPLOADS_DIR=/app/static/uploads

# ==========================================
# EMAIL (Opcional - para notificaciones)
# ==========================================
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=tu_email@gmail.com
# MAIL_PASSWORD=tu_app_password
# MAIL_DEFAULT_SENDER=noreply@androtech.es
